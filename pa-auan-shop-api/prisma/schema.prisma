generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  NOT_STARTED
  QUEUED
  COOKING
  READY
  SERVED
  CANCELLED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Category {
  id       String   @id @default(cuid())
  key      String   @unique // "bualoy" | "chaokuay" | "tubtim" | "soymilk" | "dessert"
  label    String
  colorText   String @default("text-gray-600")
  colorBg     String @default("bg-gray-50")
  colorBorder String @default("border-gray-300")
  sortOrder Int     @default(0)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Decimal  @db.Decimal(14, 3)
  image       String
  isTopping   Boolean  @default(false)
  active      Boolean  @default(true)
  bestseller  Boolean  @default(false)
  recommended Boolean  @default(false)

  // สต๊อก (สำหรับสินค้าสำเร็จรูป)
  stockQty  Int?
  stockUnit String? @default("ชิ้น")

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Order {
  id               String      @id @default(cuid())
  orderCode        String      @unique // เช่น SD2026005 ไว้แสดงผลลูกค้า/ผู้จัดการ
  tableCode        String      // เช่น A05
  paymentStatus    PaymentStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  currency         String      @default("THB")
  currencyExponent Int         @default(2)
  amountMinor      BigInt
  paymentVerified  Boolean     @default(false)
  paymentProvider  String?
  paymentTransactionId String? @unique
  paymentCurrency  String      @default("THB")
  paidAt           DateTime?
  slipImageUrl     String?
  totalAmount      Decimal     @db.Decimal(14, 3)

  items OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  productName String  // snapshot ชื่อสินค้า ณ เวลาสั่ง กันกรณีแก้ไขสินค้าภายหลัง
  unitPrice   Decimal @db.Decimal(14, 3)
  qty         Int     @default(1)
  temperature String? // "hot" | "cold"
  toppings    Json?   // [{ id, name, price }]

  createdAt DateTime @default(now())
}

model Payment {
  id                    String @id @default(cuid())
  orderId               String
  order                 Order @relation(fields: [orderId], references: [id])
  provider              String
  providerPaymentId     String?
  providerTransactionId String?
  paymentMethod         String?
  status                PaymentAttemptStatus @default(CREATED)
  amountMinor           BigInt
  refundedAmountMinor   BigInt @default(0)
  currency              String
  idempotencyKey        String
  checkoutUrl           String?
  paidAt                DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])
  @@index([orderId])
}
