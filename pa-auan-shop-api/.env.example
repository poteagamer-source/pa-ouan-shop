# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env ขึ้น git)

# เอา connection string จาก Neon Console > Connect to your database
# แนะนำ: กด "Reset password" ใน Neon ก่อนใช้ ถ้า connection string เคยหลุดไปที่อื่น (เช่น สกรีนช็อต)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-mud-ai5sjwle-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

PORT=4000

# origin ของ frontend ที่อนุญาตให้เรียก API (dev server ของ Vite)
CORS_ORIGIN=http://localhost:5173
